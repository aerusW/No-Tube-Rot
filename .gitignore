# Created by Chrome when loading the folder as an unpacked extension.
# Leave it out of any package: Firefox rejects extensions containing reserved
# underscore-prefixed names, which is what made the add-on look broken there.
_metadata/

# Packaged builds
dist/
*.zip
*.crx
*.pem
*.xpi

# web-ext's default output directory, for anyone who runs `web-ext sign`
# without --artifacts-dir. package.py and the workflows both write to dist/,
# but the tool falls back to this on its own.
web-ext-artifacts/

# AMO signing credentials. web-ext reads WEB_EXT_API_KEY / WEB_EXT_API_SECRET
# from the environment, and the obvious place to keep them is a dotenv file
# next to the repo. Signing keys must never be committable: a leaked pair lets
# anyone publish a signed add-on under this ID.
.env
.env.*
!.env.example

# Only web-ext itself needs installing, and the workflows do it globally —
# but nothing should break if someone installs it here instead.
node_modules/

# Python bytecode from the .github/scripts helpers and the test suite. Both
# set sys.dont_write_bytecode, so this should never match anything — it's a
# backstop, because __pycache__/ is another reserved underscore name in a
# folder that gets loaded as an extension. (Running the tests through
# `python -m unittest` instead of tests/run.py is the way to create one.)
__pycache__/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
