{
  "manifest_version": 3,
  "name": "No-Tube-Rot",
  "version": "1.2.0",
  "description": "Redirects the YouTube homepage to your subscriptions feed and hides all Shorts content.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://www.youtube.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "no-tube-rot@aerusw",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["hide-shorts.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
